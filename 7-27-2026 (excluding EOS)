def hhmm_to_minutes(hhmm):
    h, m = map(int, hhmm.split(":"))
    return h * 60 + m


def build_rolling_windows(start_hhmm, end_hhmm, window_minutes, date):
    base      = datetime.strptime(date, "%Y-%m-%d")
    start_min = hhmm_to_minutes(start_hhmm)
    end_min   = hhmm_to_minutes(end_hhmm)
    windows, cur = [], start_min
    while cur + window_minutes <= end_min + 1:
        ws = EST.localize(base.replace(hour=cur // 60, minute=cur % 60, second=0))
        we = EST.localize(base.replace(
            hour=(cur + window_minutes) // 60,
            minute=(cur + window_minutes) % 60, second=0))
        windows.append((ws, we))
        cur += 1   # overlapping: slide 1 minute at a time
    return windows


def safe_corr(x, y):
    pairs = [(a, b) for a, b in zip(x, y)
             if not math.isnan(a) and not math.isnan(b)]
    if len(pairs) < 3:
        return float("nan")
    xs, ys = zip(*pairs)
    try:
        r, _ = pearsonr(xs, ys)
        return r
    except Exception:
        return float("nan")


def calc_normalised_sentiment(bull, bear, tagged, total, max_weight):
    """
    Normalised sentiment score. Positive = net bullish, negative = net bearish.
    Returns nan when no tagged messages or max_weight is 0.
    """
    if tagged == 0 or max_weight == 0:
        return float("nan")
    raw = (bull - bear) / tagged * math.log(1 + total)
    return raw / max_weight


def calc_macd(values, fast=12, slow=26, signal=9):
    """
    Calculate MACD (fast EMA - slow EMA) and Signal line (EMA of MACD)
    on a list of floats. Returns (macd_line, signal_line, histogram) as lists.
    nan-safe: windows with nan density are treated as 0 for EMA purposes.
    """
    n = len(values)
    # Replace nan with 0 for EMA calculation
    v = [x if not math.isnan(x) else 0.0 for x in values]

    def ema(data, period):
        k  = 2.0 / (period + 1)
        result = [float("nan")] * len(data)
        # seed with simple average of first `period` values
        if len(data) < period:
            return result
        seed = sum(data[:period]) / period
        result[period - 1] = seed
        for i in range(period, len(data)):
            result[i] = data[i] * k + result[i - 1] * (1 - k)
        return result

    ema_fast = ema(v, fast)
    ema_slow = ema(v, slow)

    macd_line = []
    for f, s in zip(ema_fast, ema_slow):
        if math.isnan(f) or math.isnan(s):
            macd_line.append(float("nan"))
        else:
            macd_line.append(f - s)

    # Signal = EMA of macd_line (only over non-nan values)
    macd_for_signal = [x if not math.isnan(x) else 0.0 for x in macd_line]
    signal_line_raw = ema(macd_for_signal, signal)

    # Restore nan where macd was nan
    signal_line = []
    for i, s in enumerate(signal_line_raw):
        if math.isnan(macd_line[i]):
            signal_line.append(float("nan"))
        else:
            signal_line.append(s)

    histogram = []
    for m, s in zip(macd_line, signal_line):
        if math.isnan(m) or math.isnan(s):
            histogram.append(float("nan"))
        else:
            histogram.append(m - s)

    return macd_line, signal_line, histogram

# ---------------------------------------------------------------------------
# TRADE SIGNAL LOGIC — MACD entry / message-density trailing-stop exit
# Entry : price rising  AND  MACD crosses above Signal AND MACD > 0
#         AND sentiment > 0  AND  corr >= threshold          (UNCHANGED)
# Exit  : message density falls below (1 - stop_pct/100) of the peak
#         message density reached since entry.                (ONLY exit)
# No time-overlap: skip windows whose start < exit end time
# ---------------------------------------------------------------------------

def find_trade_signals(ticker, all_windows, entry_corr_threshold, trailing_stop_pct):
    trades = []

    prices     = [w["price_close"] for w in all_windows]
    densities  = [w["msg_per_min"] for w in all_windows]
    sentiments = [w["sentiment"]   for w in all_windows]

    # Price-density correlation (lookback 10 windows) — kept as optional filter
    corr_pd = []
    for i in range(len(all_windows)):
        lo = max(0, i - 9)
        corr_pd.append(safe_corr(prices[lo:i+1], densities[lo:i+1]))

    # MACD(12,26,9) on message density
    macd_line, signal_line, histogram = calc_macd(densities, fast=12, slow=26, signal=9)

    def _f(v):
        return not math.isnan(v)

    i = 0
    while i < len(all_windows):
        w     = all_windows[i]
        r_pd  = corr_pd[i]
        sent  = sentiments[i]
        macd  = macd_line[i]
        sig   = signal_line[i]
        prev_macd = macd_line[i - 1] if i > 0 else float("nan")
        prev_sig  = signal_line[i - 1] if i > 0 else float("nan")

        price_rising    = (_f(w["price_open"]) and _f(w["price_close"])
                           and w["price_close"] > w["price_open"])
        corr_ok         = _f(r_pd) and r_pd >= entry_corr_threshold
        sentiment_ok    = _f(sent) and sent > 0
        # MACD crossover above signal AND MACD itself positive
        macd_cross_up   = (_f(macd) and _f(sig) and _f(prev_macd) and _f(prev_sig)
                           and prev_macd <= prev_sig   # was at or below
                           and macd > sig              # now above
                           and macd > 0)

        if not (price_rising and corr_ok and sentiment_ok and macd_cross_up):
            i += 1
            continue

        # ── ENTERED ─────────────────────────────────────────────────────────
        entry_idx       = i
        entry_sentiment = sent
        entry_macd      = macd
        entry_signal    = sig
        peak_macd       = macd   # kept only for reporting/CSV columns, not used for exits
        # Peak MESSAGE DENSITY since entry — this is what the trailing stop now tracks.
        # Seed it with the entry window's own density (0.0 if somehow nan) so the
        # very first comparison is meaningful even on a 1-window-old trade.
        entry_density   = densities[entry_idx]
        peak_density    = entry_density if _f(entry_density) else 0.0
        exit_idx        = None
        exit_reason     = None

        j = i + 1
        while j < len(all_windows):
            wj       = all_windows[j]
            macd_j   = macd_line[j]
            density_j = densities[j]

            # Update peak MACD (reporting only — no longer an exit trigger)
            if _f(macd_j):
                peak_macd = max(peak_macd, macd_j)

            # Update peak message density seen so far during this trade
            if _f(density_j):
                peak_density = max(peak_density, density_j)

            # ONLY exit condition: message density falls below
            # (1 - stop_pct/100) of the peak density reached since entry.
            # e.g. 30% stop, peak density = 100 -> exit when density < 70.
            trailing_stop_hit = False
            if trailing_stop_pct is not None and _f(density_j) and peak_density > 0:
                stop_fraction     = trailing_stop_pct / 100.0
                trailing_stop_hit = density_j < peak_density * (1 - stop_fraction)

            if trailing_stop_hit:
                exit_idx    = j
                exit_reason = "density_trailing_stop_" + str(trailing_stop_pct) + "pct"
                break

            j += 1

        if exit_idx is None:
            exit_idx    = len(all_windows) - 1
            exit_reason = "end_of_session"

        if exit_idx == entry_idx:
            i += 1
            continue

        entry_w        = all_windows[entry_idx]
        exit_w         = all_windows[exit_idx]
        entry_price    = entry_w["price_open"]
        exit_price     = exit_w["price_close"]
        exit_sentiment = sentiments[exit_idx]
        exit_macd      = macd_line[exit_idx]
        exit_signal    = signal_line[exit_idx]
        exit_hist      = histogram[exit_idx]

        if entry_price and entry_price != 0 and _f(entry_price) and _f(exit_price):
            pct_change    = (exit_price - entry_price) / entry_price * 100
            trade_windows = all_windows[entry_idx:exit_idx + 1]
            total_m       = sum(tw["total_msgs"] for tw in trade_windows)
            avg_mpm       = sum(tw["msg_per_min"] for tw in trade_windows) / len(trade_windows)

            trades.append({
                "ticker":                   ticker,
                "entry_window":             entry_w["w_start"].strftime("%H:%M"),
                "exit_window":              exit_w["w_end"].strftime("%H:%M"),
                "entry_price":              round(entry_price, 4),
                "exit_price":               round(exit_price,  4),
                "pct_change":               round(pct_change,  4),
                "entry_corr_price_density": round(r_pd, 4)            if _f(r_pd)            else None,
                "exit_corr_price_density":  round(corr_pd[exit_idx],4) if _f(corr_pd[exit_idx]) else None,
                "entry_macd":               round(entry_macd, 6)      if _f(entry_macd)      else None,
                "exit_macd":                round(exit_macd,  6)      if _f(exit_macd)       else None,
                "entry_signal":             round(entry_signal, 6)    if _f(entry_signal)    else None,
                "exit_signal":              round(exit_signal,  6)    if _f(exit_signal)     else None,
                "exit_histogram":           round(exit_hist,   6)     if _f(exit_hist)       else None,
                "peak_macd":                round(peak_macd,   6)     if _f(peak_macd)       else None,
                "entry_sentiment":          round(entry_sentiment, 4) if _f(entry_sentiment) else None,
                "exit_sentiment":           round(exit_sentiment,  4) if _f(exit_sentiment)  else None,
                "avg_msg_per_min":          round(avg_mpm, 4),
                "total_msgs_in_trade":      total_m,
                "entry_msg_density":        round(entry_density, 6)  if _f(entry_density)   else None,
                "peak_msg_density":         round(peak_density,  6)  if _f(peak_density)    else None,
                "exit_msg_density":         round(densities[exit_idx], 6) if _f(densities[exit_idx]) else None,
                "exit_reason":              exit_reason,
            })

        # Skip forward past all windows overlapping this trade's exit time
        exit_end_time = exit_w["w_end"]
        i = exit_idx + 1
        while i < len(all_windows) and all_windows[i]["w_start"] < exit_end_time:
            i += 1

    return trades

# ---------------------------------------------------------------------------
# BUILD WINDOW DATA FOR ONE TICKER
# ---------------------------------------------------------------------------

def run_for_window(tickers, price_cache, msg_cache, date,
                   window_minutes, entry_corr_threshold, trailing_stop_pct):

    windows_meta = build_rolling_windows("04:00", "20:00", window_minutes, date)
    all_trades   = []

    for ticker in tickers:
        price_df = price_cache.get(ticker, pd.DataFrame())
        msg_df   = msg_cache.get(ticker, pd.DataFrame())

        if price_df.empty:
            continue
        if msg_df.empty or int(msg_df["total"].sum()) == 0:
            continue

        # Aggregate per-window message counts + sentiment
        all_msg_windows = []
        for ws, we in windows_meta:
            m   = msg_df[(msg_df["datetime"] >= ws) & (msg_df["datetime"] < we)]
            b   = int(m["bull"].sum())   if not m.empty else 0
            br  = int(m["bear"].sum())   if not m.empty else 0
            t   = int(m["tagged"].sum()) if not m.empty else 0
            tot = int(m["total"].sum())  if not m.empty else 0
            all_msg_windows.append((b, br, t, tot))

        # Global max_weight for normalisation across the day
        max_weight = max(
            (abs((b - br) / t * math.log(1 + tot))
             for b, br, t, tot in all_msg_windows if t > 0),
            default=1.0,
        )

        # Build per-window data
        window_data = []
        for (ws, we), (b, br, t, tot) in zip(windows_meta, all_msg_windows):
            p   = price_df[(price_df["datetime"] >= ws) & (price_df["datetime"] < we)]
            po  = p["close"].iloc[0]  if len(p) >= 1 else float("nan")
            pc  = p["close"].iloc[-1] if len(p) >= 1 else float("nan")
            mpm = tot / window_minutes
            sent = calc_normalised_sentiment(b, br, t, tot, max_weight)
            window_data.append({
                "w_start":     ws,
                "w_end":       we,
                "price_open":  po,
                "price_close": pc,
                "total_msgs":  tot,
                "msg_per_min": mpm,
                "sentiment":   sent,
            })

        trades = find_trade_signals(ticker, window_data,
                                    entry_corr_threshold, trailing_stop_pct)
        all_trades.extend(trades)

    if not all_trades:
        return pd.DataFrame()
    return pd.DataFrame(all_trades).reset_index(drop=True)

