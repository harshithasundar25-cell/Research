def count_exit_reasons(df_result):
    """
    Categorize the exit_reason column into buckets so we can see, per
    parameter value, exactly what is actually closing trades.

    NOTE: in the current strategy, macd_cross_below_signal, sentiment_negative,
    and price_decreasing are NOT wired up as exit conditions anymore (only
    the message-density trailing stop and end-of-session are). Those three
    buckets are kept here so the counts can PROVE that — if this file is the
    one actually being run, they will always read 0. Nonzero counts there
    would mean an older version of the exit logic is executing instead.
    """
    counts = {
        "trailing_stop":  0,
        "macd_cross":     0,
        "sentiment":      0,
        "price_decrease": 0,
        "end_of_session": 0,
        "other":          0,
    }
    if df_result is None or df_result.empty:
        return counts
    for reason in df_result["exit_reason"]:
        reason = str(reason)
        if reason.startswith("density_trailing_stop_"):
            counts["trailing_stop"] += 1
        elif reason == "macd_cross_below_signal":
            counts["macd_cross"] += 1
        elif reason == "sentiment_negative":
            counts["sentiment"] += 1
        elif reason == "price_decreasing":
            counts["price_decrease"] += 1
        elif reason == "end_of_session":
            counts["end_of_session"] += 1
        else:
            counts["other"] += 1
    return counts


def print_exit_reason_table(market_cap, opt_mode, reason_rows):
    """
    Print, for every swept parameter value, a breakdown of how many trades
    exited via each mechanism. reason_rows is a list of dicts:
    {"value": <param value>, **counts_dict}
    """
    if not reason_rows:
        return
    value_label = {
        "threshold": "Threshold",
        "window":    "Window(min)",
    }.get(opt_mode, "Stop%")

    print("\n  Exit-reason breakdown — " + market_cap.upper() + "  (" + opt_mode + " sweep)")
    header = "  {:>12} | {:>14} | {:>10} | {:>9} | {:>14} | {:>14} | {:>7}".format(
        value_label, "TrailingStop", "MACDcross", "Sentiment", "PriceDecrease",
        "EndOfSession", "Other"
    )
    print(header)
    print("  " + "-" * (len(header) - 2))
    for row in reason_rows:
        print("  {:>12} | {:>14} | {:>10} | {:>9} | {:>14} | {:>14} | {:>7}".format(
            row["value"], row["trailing_stop"], row["macd_cross"], row["sentiment"],
            row["price_decrease"], row["end_of_session"], row["other"]
        ))
    print()


def build_stoploss_summary_row(val, df_subset):
    """Build one summary-table row (avg/median profit, trade count, avg duration) for a
    given stop-loss value from a (possibly filtered) trades DataFrame."""
    if df_subset is not None and not df_subset.empty:
        durations = [
            trade_duration_minutes(r.entry_window, r.exit_window)
            for r in df_subset.itertuples(index=False)
        ]
        durations = [d for d in durations if not math.isnan(d)]
        return {
            "stop_pct":        val,
            "avg_profit":      df_subset["pct_change"].mean(),
            "median_profit":   df_subset["pct_change"].median(),
            "num_trades":      len(df_subset),
            "avg_duration_min": (sum(durations) / len(durations)) if durations else float("nan"),
        }
    return {
        "stop_pct":        val,
        "avg_profit":      float("nan"),
        "median_profit":   float("nan"),
        "num_trades":      0,
        "avg_duration_min": float("nan"),
    }


def run_sweep_for_cap(market_cap, tickers, price_cache, msg_cache,
                      date, opt_mode, sweep_values,
                      fixed_window, trailing_stop, entry_corr, out_dir):
    # Guarantee the folder exists right before we try to write into it
    os.makedirs(out_dir, exist_ok=True)
    print("\n" + "─" * 50)
    print("  Market cap: " + market_cap.upper() + "  (" + str(len(tickers)) + " tickers)")

    summary_rows      = []  # only populated/used when opt_mode == "stop loss"
    exit_reason_rows  = []  # populated for EVERY sweep mode

    for val in sweep_values:
        if opt_mode == "threshold":
            ec    = val
            wm    = fixed_window
            stop  = trailing_stop
            label = "threshold" + str(val)
        elif opt_mode == "window":
            ec    = entry_corr
            wm    = val
            stop  = trailing_stop
            label = "window" + str(val) + "min"
        else:
            ec    = entry_corr
            wm    = fixed_window
            stop  = val
            label = "stop" + str(val) + "pct"

        df_result = run_for_window(tickers, price_cache, msg_cache, date, wm, ec, stop)

        out_filename = date + "-" + label + "-" + market_cap + ".csv"
        out_path     = os.path.join(out_dir, out_filename)

        if df_result is not None and not df_result.empty:
            df_result.to_csv(out_path, index=False)
            total  = len(df_result)
            wins   = (df_result["pct_change"] > 0).sum()
            losses = (df_result["pct_change"] <= 0).sum()
            print("  " + label + " -> " + str(total) + " trades  "
                  + "wins=" + str(wins) + "  losses=" + str(losses)
                  + "  winrate=" + str(round(wins / total * 100, 1)) + "%"
                  + "  [" + out_filename + "]")
        else:
            pd.DataFrame(columns=EMPTY_COLS).to_csv(out_path, index=False)
            print("  " + label + " -> 0 trades  [" + out_filename + "]")

        reason_counts = count_exit_reasons(df_result)
        exit_reason_rows.append({"value": val, **reason_counts})

        # Collect per-stop-value summary stats (only meaningful in stop-loss mode).
        # Trades that only closed because the session ran out never actually
        # got exercised by the trailing stop, so they're excluded here — every
        # stop-loss graph/table reflects trailing-stop exits only.
        if opt_mode == "stop loss":
            if df_result is not None and not df_result.empty:
                df_completed = df_result[df_result["exit_reason"] != "end_of_session"]
            else:
                df_completed = df_result
            summary_rows.append(build_stoploss_summary_row(val, df_completed))

    print_exit_reason_table(market_cap, opt_mode, exit_reason_rows)

    if opt_mode == "stop loss":
        generate_stoploss_graph_and_summary(market_cap, summary_rows, out_dir)


def generate_stoploss_graph_and_summary(market_cap, summary_rows, out_dir):
    """
    Build the dual-axis stop-loss graph (avg % profit vs. # completed trades)
    for one market cap, save it as stoploss_<cap>.png in out_dir, and print
    a numeric validation table alongside it.

    summary_rows already excludes trades that closed via end_of_session —
    only trades actually closed by the trailing stop are reflected here.
    """
    if not summary_rows:
        print("  [" + market_cap + "] No summary data to plot — skipping graph.")
        return

    summary_df = pd.DataFrame(summary_rows).sort_values("stop_pct").reset_index(drop=True)

    stop_pcts   = summary_df["stop_pct"].tolist()
    avg_profits = summary_df["avg_profit"].tolist()
    num_trades  = summary_df["num_trades"].tolist()

    fig, ax_left = plt.subplots(figsize=(9, 5.5))

    color_profit = "#1f77b4"
    color_trades = "#d62728"

    ax_left.set_xlabel("Stop-Loss Percentage (%)")
    ax_left.set_ylabel("Average Percent Profit (%)", color=color_profit)
    line_profit, = ax_left.plot(
        stop_pcts, avg_profits, marker="o", color=color_profit, label="Avg % Profit"
    )
    ax_left.tick_params(axis="y", labelcolor=color_profit)
    ax_left.axhline(0, color="grey", linewidth=0.8, linestyle="--")

    ax_right = ax_left.twinx()
    ax_right.set_ylabel("Number of Completed Trades", color=color_trades)
    line_trades, = ax_right.plot(
        stop_pcts, num_trades, marker="s", color=color_trades,
        linestyle="--", label="Completed Trades"
    )
    ax_right.tick_params(axis="y", labelcolor=color_trades)

    ax_left.set_xticks(stop_pcts)
    ax_left.set_title(
        "Stop-Loss Optimization — " + market_cap.upper()
        + " (Message-Density Trailing Stop, Trailing-Stop Exits Only)"
    )
    ax_left.legend(
        handles=[line_profit, line_trades], loc="best"
    )
    fig.tight_layout()

    png_path = os.path.join(out_dir, "stoploss_" + market_cap + ".png")
    fig.savefig(png_path, dpi=150)
    plt.close(fig)
    print("  [" + market_cap + "] Saved graph: " + png_path)

    # Validation table
    print("\n  Validation table — " + market_cap.upper() + " (trailing-stop exits only)")
    header = "  {:>9} | {:>12} | {:>13} | {:>8} | {:>18}".format(
        "Stop %", "Avg Profit%", "Median Prft%", "# Trades", "Avg Duration(min)"
    )
    print(header)
    print("  " + "-" * (len(header) - 2))
    for row in summary_df.itertuples(index=False):
        avg_p = "n/a" if math.isnan(row.avg_profit) else str(round(row.avg_profit, 3))
        med_p = "n/a" if math.isnan(row.median_profit) else str(round(row.median_profit, 3))
        avg_d = "n/a" if math.isnan(row.avg_duration_min) else str(round(row.avg_duration_min, 1))
        print("  {:>9} | {:>12} | {:>13} | {:>8} | {:>18}".format(
            str(row.stop_pct) + "%", avg_p, med_p, int(row.num_trades), avg_d
        ))
    print()

